FROM python:3.11-slim

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Copy requirements specifically from the agent folder
COPY agent/requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1000 -r requirements.txt

# Copy the ENTIRE project to the container's /app directory (so that context_builder, mcp_server, and data are all included)
COPY . .

# Launch the agent script from the /app root
ENTRYPOINT ["python", "agent/agent.py"]